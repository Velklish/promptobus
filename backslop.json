{
  "prefix": "PB",
  "docs": "docs",
  "cli": "npx --no-install backslop",
  "gates": [
    "npm test",
    "npx --no-install backslop lint",
    "npm run audit",
    "npm run pins",
    "npm run codex-schema"
  ],
  "probe": "npm run probe",
  "writer": {
    "style": [
      "lib/cli.js"
    ],
    "currency": [
      "skills/**"
    ]
  },
  "version": "0.20.0",
  "source": "https://github.com/Velklish/backslop.git",
  "lang": "en",
  "tools": [
    "claude",
    "cursor",
    "codex"
  ],
  "hooks": [
    "claude"
  ]
}
