{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptobus:v1:task",
  "title": "Task",
  "description": "Журнал задачи protocol v1. Owner — ID участника; участники лежат здесь же.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "owner", "created", "updated", "participants", "adapter"],
  "properties": {
    "schemaVersion": {
      "description": "Версия схемы записи. Более новая блокирует запись, не меняя store.",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": { "enum": ["active", "done"] },
    "owner": {
      "description": "ID участника-владельца. Их всегда ровно один, смена — явным claim.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "created": { "$ref": "urn:promptobus:v1:task#/$defs/timestamp" },
    "updated": { "$ref": "urn:promptobus:v1:task#/$defs/timestamp" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:promptobus:v1:participant" }
    },
    "adapter": {
      "description": "Метаданные adapter'а как opaque объект: core в них не заглядывает.",
      "type": "object"
    }
  },
  "$defs": {
    "timestamp": {
      "description": "Ровно то, что печатает Date#toISOString: формата date-time мало — он допускает смещения.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
