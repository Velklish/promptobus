{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowUnreachableCode": false,
    "rootDir": ".",
    "outDir": "."
  },
  "include": ["lib/**/*.ts", "lib/**/*.mts", "lib/**/*.cts", "bin/**/*.ts", "bin/**/*.mts", "bin/**/*.cts"],
  "exclude": ["node_modules", "dist", "**/*.d.mts", "**/*.d.cts"]
}
