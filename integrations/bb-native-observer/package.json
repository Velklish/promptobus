{
  "name": "bb-plugin-promptobus-native-panel",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.47.1",
    "bbPluginSdk": "0.6.79",
    "node": ">=22"
  },
  "bb": {
    "name": "Promptobus Native Panel [Experimental]",
    "description": "Observe native Promptobus tasks, participants and canonical messages in a read-only dashboard.",
    "branding": {
      "icon": "Activity"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "7.6.13",
    "hono": "4.13.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm --prefix ../.. run build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/integrations/bb-native-observer/test/*.test.js",
    "build": "node scripts/build.mjs",
    "check:clean-bundle": "node scripts/check-clean-bundle.mjs"
  },
  "files": [
    "*.ts",
    "*.tsx",
    "dist",
    "skills",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE"
  ]
}
