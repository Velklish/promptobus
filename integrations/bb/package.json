{
  "name": "bb-plugin-promptobus",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": "0.48.0",
    "bbPluginSdk": "0.6.94"
  },
  "bb": {
    "name": "Promptobus",
    "description": "Local engine-backed task participants and read-only Codex reviewers in BB.",
    "branding": {
      "icon": "Workflow"
    }
  },
  "dependencies": {
    "promptobus": "file:../..",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.19.11",
    "better-sqlite3": "12.10.0",
    "cron-parser": "5.5.0",
    "hono": "4.13.13",
    "typescript": "7.0.2"
  },
  "scripts": {
    "skills:render": "node scripts/render-skills.mjs",
    "skills:check": "node scripts/render-skills.mjs --check",
    "check": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "tsc -p tsconfig.json --noEmit false --outDir .test-build && node --test test/*.test.mjs"
  },
  "files": [
    "*.ts",
    "skills",
    "scripts",
    "dist",
    "README.md",
    "PLUGIN_OVERVIEW.md"
  ]
}
