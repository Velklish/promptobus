{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptobus:v1:task",
  "title": "Task",
  "description": "A protocol v1 task record. Owner is a participant ID; the participants live right here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "owner", "created", "updated", "participants", "adapter"],
  "properties": {
    "schemaVersion": {
      "description": "The record's schema version. A newer one blocks the record without changing the store.",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": { "enum": ["active", "done"] },
    "parent": {
      "description": "The root task id for a child task. A parent is an id, never an embedded task; the store checks that it names a root.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "owner": {
      "description": "The owning participant's ID. There is always exactly one; changing it takes an explicit claim.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "created": { "$ref": "urn:promptobus:v1:task#/$defs/timestamp" },
    "updated": { "$ref": "urn:promptobus:v1:task#/$defs/timestamp" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:promptobus:v1:participant" }
    },
    "adapter": {
      "description": "The adapter's metadata as an opaque object: the core never looks inside it.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "required": ["parent"] },
      "then": {
        "properties": {
          "participants": {
            "items": {
              "not": {
                "anyOf": [
                  { "properties": { "role": { "const": "teamlead" } }, "required": ["role"] },
                  {
                    "properties": {
                      "metadata": {
                        "properties": { "address": { "type": "string", "pattern": "^teamlead:" } },
                        "required": ["address"]
                      }
                    },
                    "required": ["metadata"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "description": "Exactly what Date#toISOString prints: the date-time format alone is not enough — it allows offsets.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
